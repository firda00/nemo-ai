# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files and deployment credentials. Keep only documented examples tracked.
.env
.env.*
!.env.example
!.env.*.example

# Supabase / build artifacts
supabase/.temp
supabase/.branches
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gstack/

# Multi-agent runtime state and browser evidence
agent-hub/state/*.json
!agent-hub/state/*.example.json
agent-hub/artifacts/

# gstack worktrees — a nested checkout, never part of the repo
.claude/worktrees/
agent-hub/artifacts/

# Доступы к серверу. Файл лежит в отслеживаемой папке docs/, и от публикации его спасало
# только то, что никто не сделал `git add docs/`. Одной невнимательной команды достаточно,
# чтобы логин и пароль от боевого сервера оказались в открытом репозитории навсегда —
# история git не забывает, и удалить это потом можно только переписыванием всей ветки.
docs/SERVER_SSH_ACCESS_RU.md

# Выгрузки лидов: CLI пишет их в текущий каталог по умолчанию.
sdr-leads-*.csv
sdr-leads-*.json

# Отчёты аудита: результат прогона, а не исходник — в репозитории им делать нечего.
qa-reports/

# Отчёты гейта качества. Перезаписываются КАЖДЫМ прогоном — меняется только временная метка внутри,
# поэтому в истории они дают шум, а в рабочем дереве грязный git status после любой проверки.
# Никто их не читает: security-contracts.mjs и ui-stability-contracts.mjs только пишут.
agent-hub/security-contracts-report.json
agent-hub/ui-stability-contracts-report.json

# Выгрузки локальных прогонов. Инструмент fs_export пишет в текущий каталог, а запускают его из корня.
#
# Маска ПРИВЯЗАНА К КОРНЮ (/*.csv), а не задана как *.csv. Разница существенная: в репозитории есть
# agent-hub/fixtures/uzum-sales-sample.csv, и общая маска не сняла бы его с отслеживания (git этого не
# делает), но молча спрятала бы следующую фикстуру, которую кто-то добавит. Ошибка обнаружилась бы
# при чужом клоне, где тестов вдруг не хватает данных.
/*.csv
/report.json
/qa_result.md
/audit_test.md

# Настройки предпросмотра для этой машины: имя команды и порт локального dev-сервера.
#
# ИМЕННО ФАЙЛ, А НЕ ВЕСЬ КАТАЛОГ .claude/. В нём 97 отслеживаемых файлов — хуки контроля владения
# файлами и проверки gstack, которых требует CLAUDE.md, и библиотека скиллов. Это общая
# инфраструктура проекта, а не локальная настройка: спрятать её значит забрать её у всех остальных.
/.claude/launch.json
