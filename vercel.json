{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/uzum/:action(check|create|confirm|reverse|status)",
      "destination": "https://ogfmyjiuqmgroobckdyw.supabase.co/functions/v1/uzum-merchant/:action"
    },
    {
      "source": "/api/marketing/generate-campaign",
      "destination": "https://ogfmyjiuqmgroobckdyw.supabase.co/functions/v1/generate-campaign"
    },
    {
      "source": "/api/finance/analyze-cashflow",
      "destination": "https://ogfmyjiuqmgroobckdyw.supabase.co/functions/v1/finance-analyze-cashflow"
    },
    {
      "source": "/api/research/analyze-multimodal",
      "destination": "https://ogfmyjiuqmgroobckdyw.supabase.co/functions/v1/research-analyze-multimodal"
    },
    {
      "source": "/download/cli",
      "destination": "/nemo-cli.tgz"
    },
    {
      "source": "/((?!api/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/install.ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/download/cli",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/gzip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"nemo-cli.tgz\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
