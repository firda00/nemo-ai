# Переменные СЕРВЕРНОГО контура (docker-compose.prod.yml). Файл — ОБРАЗЕЦ, значений здесь нет.
#
#   cp deploy/.env.server.example .env.server && $EDITOR .env.server
#
# .env.server лежит в .gitignore и не должен попадать в репозиторий ни при каких обстоятельствах.
#
# ЧЕМ ЭТОТ ФАЙЛ ОТЛИЧАЕТСЯ ОТ .env.production.example В КОРНЕ.
# Тот — для Vercel, и в нём ТОЛЬКО переменные VITE_, то есть публичные: всё с этим префиксом
# попадает в код страницы и видно любому посетителю. Здесь — серверные секреты, которым в браузере
# не место никогда. Файлы разделены нарочно, чтобы служебный ключ не уехал в панель фронтенда
# заодно с остальными.

# ── База ────────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=nemo
POSTGRES_USER=nemo
# Обязателен. Наружу порт не публикуется, но пароль всё равно нужен настоящий: контур не
# заканчивается на границе машины, а скомпрометированный контейнер оказывается с ней в одной сети.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Подписи и токены ────────────────────────────────────────────────────────────────────────
# Перец для отпечатков токенов платформы. В продакшне запасного значения НЕТ намеренно: подставить
# случайное молча значило бы обесценить все ранее выданные токены без единого слова.
#   openssl rand -hex 32
NEMO_TOKEN_PEPPER=

# Секрет приёма вебхуков CRM. Необязателен: без него приём просто выключен, шлюз поднимается.
# ТОЛЬКО ASCII — значение едет в HTTP-заголовке, и с кириллицей клиент физически не сможет его
# отправить: fetch и curl отвергнут такой заголовок на своей стороне.
NEMO_CRM_WEBHOOK_SECRET=

# ── Внешние службы ──────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# Уведомления SDR-воркера. Пусто — воркер работает, но о находках не пишет.
SDR_TELEGRAM_BOT_TOKEN=
SDR_TELEGRAM_CHAT_ID=

# ── Supabase ────────────────────────────────────────────────────────────────────────────────
# Нужны, ПОКА часть логики живёт в Edge Functions: они на своём сервере не запускаются, и шлюз
# продолжает обращаться к проекту Supabase. После полного переноса логики в шлюз эти три станут
# лишними — но не раньше, и убирать их «на всякий случай» нельзя.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# СЛУЖЕБНЫЙ ключ (service_role). Обходит RLS целиком. В браузер не попадает и попасть не должен.
SUPABASE_SERVICE_ROLE_KEY=

# ── Домены и сертификаты ────────────────────────────────────────────────────────────────────
# Адрес для уведомлений Let's Encrypt об истечении сертификата. Обязателен.
ACME_EMAIL=

SITE_ROOT_DOMAIN=nemoai.uz
SITE_APP_DOMAIN=app.nemoai.uz
SITE_API_DOMAIN=api.nemoai.uz

# ── Сборка фронтенда ────────────────────────────────────────────────────────────────────────
# Попадают в код страницы на этапе СБОРКИ образа — подставить их в готовый образ нельзя.
# Публичные: это те же значения, что уходят на Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Домен, с которого отдаётся widget.js, — обычно https://api.nemoai.uz
VITE_API_GATEWAY_URL=
