# Переменные СЕРВЕРНОГО контура (docker-compose.prod.yml). Файл — ОБРАЗЕЦ, значений здесь нет.
#
#   cp deploy/.env.server.example .env.server && $EDITOR .env.server
#
# .env.server лежит в .gitignore и не должен попадать в репозиторий ни при каких обстоятельствах.
#
# ЧЕМ ЭТОТ ФАЙЛ ОТЛИЧАЕТСЯ ОТ .env.production.example В КОРНЕ.
# Тот — для Vercel, и в нём ТОЛЬКО переменные VITE_, то есть публичные: всё с этим префиксом
# попадает в код страницы и видно любому посетителю. Здесь — серверные секреты, которым в браузере
# не место никогда. Файлы разделены нарочно, чтобы служебный ключ не уехал в панель фронтенда
# заодно с остальными.

# ── База ────────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=nemo
POSTGRES_USER=nemo
# Обязателен. Наружу порт не публикуется, но пароль всё равно нужен настоящий: контур не
# заканчивается на границе машины, а скомпрометированный контейнер оказывается с ней в одной сети.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Подписи и токены ────────────────────────────────────────────────────────────────────────
# Перец для отпечатков токенов платформы. В продакшне запасного значения НЕТ намеренно: подставить
# случайное молча значило бы обесценить все ранее выданные токены без единого слова.
#   openssl rand -hex 32
NEMO_TOKEN_PEPPER=

# Отдельный HMAC-перец публичной waitlist-формы. Edge Function без него намеренно отвечает 503,
# чтобы IP-адреса не хэшировались перебираемым значением. Не короче 32 символов; не используйте
# NEMO_TOKEN_PEPPER повторно — у секретов разные назначения и ротация должна быть независимой.
#   openssl rand -hex 32
WAITLIST_IP_PEPPER=

# Секрет приёма вебхуков CRM. Необязателен: без него приём просто выключен, шлюз поднимается.
# ТОЛЬКО ASCII — значение едет в HTTP-заголовке, и с кириллицей клиент физически не сможет его
# отправить: fetch и curl отвергнут такой заголовок на своей стороне.
NEMO_CRM_WEBHOOK_SECRET=

# ── Внешние службы ──────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# Уведомления SDR-воркера. Пусто — воркер работает, но о находках не пишет.
SDR_TELEGRAM_BOT_TOKEN=
SDR_TELEGRAM_CHAT_ID=

# ── Supabase контура ────────────────────────────────────────────────────────────────────────
#
# Внутри контура Supabase СВОЙ: postgres, kong, auth, rest, realtime, storage, edge-runtime.
# Шлюз, воркер и Edge Functions обращаются к нему по внутреннему имени http://kong:8000 — это
# прописано в compose и здесь не настраивается. Наружу он выходит через Caddy на домене
# SITE_SUPABASE_DOMAIN, и именно этот адрес видит браузер.

# Секрет подписи токенов. Не короче 32 знаков — это требование GoTrue, а не осторожность:
# с коротким он поднимется и будет выпускать токены, подбираемые перебором за часы.
#   openssl rand -hex 32
JWT_SECRET=

# Ключи проекта. Это НЕ случайные строки, а JWT, подписанные тем же JWT_SECRET: PostgREST читает
# из них поле role и по нему выбирает роль в базе. Выпустить их вручную нельзя — только скриптом:
#   node deploy/make-keys.mjs "$JWT_SECRET"
ANON_KEY=
# Обходит RLS целиком. В браузер не попадает и попасть не должен.
SERVICE_ROLE_KEY=

# Внешний адрес Kong целиком, со схемой: на него GoTrue строит ссылки в письмах подтверждения.
# Обычно https://supabase.nemoai.uz
SUPABASE_PUBLIC_URL=

# Куда возвращать после входа. Обычно https://app.nemoai.uz
SITE_URL=

# Дополнительные разрешённые адреса возврата, через запятую. Пусто — разрешён только SITE_URL.
# Открытый список здесь — это открытый редирект: ссылка на «вход» уводит на чужой сайт с токеном.
ADDITIONAL_REDIRECT_URLS=

# true закрывает саморегистрацию: пользователей заводит только администратор.
DISABLE_SIGNUP=false

# Схемы, которые PostgREST отдаёт наружу. Добавлять сюда служебные схемы нельзя — всё, что здесь
# перечислено, доступно клиенту в браузере в пределах RLS.
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Ключи Realtime. Длина проверяется самой службой: короче — не поднимется.
#   openssl rand -hex 8    (ровно 16 знаков)
REALTIME_ENC_KEY=
#   openssl rand -hex 32   (не короче 64 знаков)
REALTIME_SECRET_KEY_BASE=

# Почта для писем подтверждения. ПУСТО — и MAILER_AUTOCONFIRM обязан остаться true: включить
# подтверждение без работающего SMTP значит запереть каждого нового пользователя навсегда.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# Подпись вебхука Stripe — нужна edge-runtime, если платежи включены.
STRIPE_WEBHOOK_SECRET=

# Durable PROFILE_C_BROWSER media worker. Exact comma-separated Object Storage hosts only;
# wildcards, IP literals and private/link-local DNS answers are rejected by the worker.
MEDIA_STORAGE_HOST_ALLOWLIST=YOUR_PROJECT_REF.supabase.co

# ── Домены и сертификаты ────────────────────────────────────────────────────────────────────
# Адрес для уведомлений Let's Encrypt об истечении сертификата. Обязателен.
ACME_EMAIL=

SITE_ROOT_DOMAIN=nemoai.uz
SITE_APP_DOMAIN=app.nemoai.uz
SITE_API_DOMAIN=api.nemoai.uz
SITE_SUPABASE_DOMAIN=supabase.nemoai.uz

# ── Сборка фронтенда ────────────────────────────────────────────────────────────────────────
# Попадают в код страницы на этапе СБОРКИ образа — подставить их в готовый образ нельзя.
# Публичные: это те же значения, что уходят на Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Домен, с которого отдаётся widget.js, — обычно https://api.nemoai.uz
VITE_API_GATEWAY_URL=
