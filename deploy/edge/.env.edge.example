# Pin immutable, signed images produced by the Nemo release pipeline.
NEMO_EDGE_GATEWAY_IMAGE=ghcr.io/firda00/nemo-edge-gateway:2026.08.25
NEMO_EDGE_MEDIA_IMAGE=ghcr.io/firda00/nemo-edge-media:2026.08.25
NEMO_EDGE_SYNC_IMAGE=ghcr.io/firda00/nemo-edge-sync:2026.08.25

# Bind to the client's LAN interface only; never use 0.0.0.0 on an untrusted network.
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_VISION_PORT=3000

# Exact cloud endpoint. The bridge requires HTTPS and refuses redirects.
EDGE_CLOUD_SYNC_URL=https://gateway.nemo-ai.uz/v1/edge/events

# Ollama stays on the Edge Box. No cloud key is passed to the local endpoint.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Create these files with 0600 permissions during provisioning. Never commit their contents.
EDGE_DEVICE_HMAC_KEY_FILE_HOST=./secrets/device-hmac.key
EDGE_SYNC_HMAC_KEY_FILE_HOST=./secrets/sync-hmac.key
EDGE_WORKER_TOKEN_FILE_HOST=./secrets/worker.token
