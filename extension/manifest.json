{
  "manifest_version": 3,
  "key": "",
  "name": "Nemo — загрузчик товаров в Uzum",
  "version": "0.1.0",
  "description": "Переносит готовый черновик карточки из Nemo в кабинет Uzum Seller и отправляет его на модерацию.",
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://seller.uzum.uz/*",
    "https://ogfmyjiuqmgroobckdyw.supabase.co/*"
  ],
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.uzum.uz/*"
      ],
      "js": [
        "scanner.js",
        "executor.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://nemo-ai-swart.vercel.app/*",
      "https://nemo-ai-firda00s-projects.vercel.app/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nemo — загрузчик товаров"
  }
}
