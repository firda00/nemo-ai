# Образец окружения для docker-compose. Скопировать в .env рядом с docker-compose.yml и заполнить.
#
#   cp infra/docker/env.example .env
#
# Файл лежит ЗДЕСЬ, а не как `.env.example` в корне: `.gitignore` этого проекта исключает `.env.*`
# целиком, и образец рядом с секретами просто не попал бы в репозиторий.
#
# НИ ОДНО значение ниже не является настоящим. Заполненный `.env` в git не коммитить.

# ── Обязательное для шлюза ───────────────────────────────────────────────────────────────────────
# Без любого из трёх шлюз не стартует и назовёт недостающие имена (см. requireEnv в main.ts).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Перец отпечатка платформенных токенов.
#
# ТОТ ЖЕ САМЫЙ, что у Edge Function sdr-api. Разные значения означают, что один и тот же токен
# принимают в одну дверь и не принимают в другую, а выглядит это как «ключ иногда не работает».
NEMO_TOKEN_PEPPER=<общий-перец-с-edge-function>

# ── Приём вебхуков CRM ───────────────────────────────────────────────────────────────────────────
# Не задан — приём ВЫКЛЮЧЕН (503), а не открыт для всех.
#
# ТОЛЬКО ASCII: значение едет в HTTP-заголовке, и клиент с кириллицей внутри не сможет отправить
# запрос вовсе — fetch и curl отвергнут его на своей стороне. Шлюз проверяет это при старте.
NEMO_CRM_WEBHOOK_SECRET=

# ── Воркер ───────────────────────────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=<project-ref>
OPENROUTER_API_KEY=
SDR_TELEGRAM_BOT_TOKEN=
SDR_TELEGRAM_CHAT_ID=
CRM_WEBHOOK_URL=

# Разбор сайтов браузером. По умолчанию ВЫКЛЮЧЕН: в образе воркера нет Chromium, и включение здесь
# без пересборки образа с браузером ничего не даст, кроме записей browser_error_not_installed.
SDR_BROWSER=0

# ── Порты и пределы ──────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
DRAGONFLY_MAXMEMORY=1gb
