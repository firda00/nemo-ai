# Переменные продакшн-сборки. Файл — ОБРАЗЕЦ: значений здесь нет и быть не должно.
# Скопируйте в панель хостинга (Vercel → Settings → Environment Variables) и заполните там.
#
# ВСЁ, ЧТО НАЧИНАЕТСЯ НА VITE_, ПОПАДАЕТ В КОД СТРАНИЦЫ И ВИДНО ЛЮБОМУ ПОСЕТИТЕЛЮ.
# Сюда кладут только публичные значения. Служебный ключ Supabase, токены ботов, ключи провайдеров
# живут в переменных Edge Functions и шлюза — во фронтенде им не место ни при каких условиях.

# ── Обязательные ────────────────────────────────────────────────────────────────────────────────
# Без них сборка падает: см. проверку в vite.config.ts. Пустая строка тоже считается отсутствием —
# с пустым URL приложение молча уходит в демо-режим, и человек видит подставные данные вместо своих.

# Адрес проекта Supabase, например https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Публикуемый ключ (anon / publishable). НЕ service_role.
VITE_SUPABASE_ANON_KEY=

# Адрес шлюза, с которого отдаётся widget.js. Отсюда берётся сниппет, который клиент вставляет
# себе на сайт. Раньше адрес был вписан в три места в коде и в двух из них не совпадал с третьим:
# страница интеграций отдавала один хост, онбординг — другой.
VITE_API_GATEWAY_URL=

# ── Необязательные ──────────────────────────────────────────────────────────────────────────────

# Идентификатор расширения браузера. Пусто — возможности расширения просто не предлагаются.
VITE_NEMO_EXTENSION_ID=

# Приём ошибок Sentry. Пусто — отчёты об ошибках не отправляются.
VITE_SENTRY_DSN=

# ── Намеренно отсутствует ───────────────────────────────────────────────────────────────────────
# VITE_APP_URL — кодом НЕ читается, и это правильно. Приложение живёт на двух хостах (корневой —
# промо, app.* — кабинет) и берёт свой адрес из браузера через window.location.origin. Прибитый
# в сборку адрес сломал бы ровно один из двух хостов, причём молча. Переменная не заведена, чтобы
# её не выставили в ожидании действия, которого не будет.
