# Frontend env — copy to .env.local and fill in to switch from DEMO mode to the
# live Supabase backend. Only PUBLIC values go here (never service_role / secrets).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SENTRY_DSN=

# Optional Uzbek Telegram STT pilot. Audio is sent to this external Hugging Face
# Space only when OpenRouter STT fails (or the agent language is explicitly uz).
UZ_STT_SPACE_URL=
